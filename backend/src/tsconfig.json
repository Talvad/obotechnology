{
  "compilerOptions": {
    "target": "es2022",
    "strict": true,
    "types": ["node"],
    "preserveConstEnums": true,
    "noEmit": true,
    "sourceMap": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "**/*.test.ts"]
}
